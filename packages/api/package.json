{
  "name": "@zebra/api",
  "version": "2.0.0",
  "description": "Zebra HMAI Backend API (NestJS + Fastify)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "DISABLE_AUTH=true nest start --watch",
    "start:debug": "DISABLE_AUTH=true nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome check --apply-unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:e2e": "vitest --config ./test/vitest-e2e.config.ts"
  },
  "dependencies": {
    "@fast-csv/parse": "^5.0.5",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^8.0.2",
    "@nestjs/axios": "^3.1.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^8.0.4",
    "@nestjs/terminus": "^11.0.0",
    "@zebra/shared": "workspace:*",
    "axios": "^1.7.9",
    "basic-ftp": "^5.0.5",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.63.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.2.3",
    "fast-csv": "^5.0.5",
    "fast-xml-parser": "^4.5.1",
    "ioredis": "^5.8.2",
    "mysql2": "^3.11.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/cli": "^0.5.1",
    "@swc/core": "^1.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@vitest/coverage-v8": "^2.1.5",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "keywords": [
    "nestjs",
    "fastify",
    "mainframe",
    "monitoring",
    "rmf",
    "hmai"
  ],
  "author": "",
  "license": "EPL-2.0"
}
